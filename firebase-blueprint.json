{
  "entities": {
    "Settings": {
      "title": "Website Settings",
      "description": "Global settings for the portfolio website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "surname": { "type": "string" },
        "bio": { "type": "string" },
        "profileImage": { "type": "string" },
        "email": { "type": "string" },
        "points": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of key professional points/specializations."
        },
        "stats": {
          "type": "object",
          "properties": {
            "socialProjects": { "type": "string" },
            "webApps": { "type": "string" },
            "successRate": { "type": "string" }
          }
        }
      },
      "required": ["name", "surname", "bio", "profileImage", "email"]
    },
    "Project": {
      "title": "Portfolio Project",
      "description": "A project showcased in the portfolio.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string" },
        "github": { "type": "string" },
        "type": { "type": "string", "enum": ["web", "app", "graphic", "digital", "cpa", "other"] },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "dateReceived": { "type": "string" },
        "completionTime": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "downloadFileName": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "description", "type", "image"]
    },
    "Experience": {
      "title": "Work Experience",
      "description": "Professional experience entry.",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["company", "role", "period", "description"]
    },
    "Blog": {
      "title": "Blog Post",
      "description": "A blog post or gallery item.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "image", "content"]
    }
  },
  "firestore": {
    "settings/global": {
      "schema": "Settings",
      "description": "Global website configuration. Only editable by admins (UID: aU9LuKXO1FNsCAZlnLEKML5yuB92 or email: mehedihasanajmir2@gmail.com)."
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "List of portfolio projects."
    },
    "experience/{expId}": {
      "schema": "Experience",
      "description": "List of professional experiences."
    },
    "blogs/{blogId}": {
      "schema": "Blog",
      "description": "Photos and blog posts."
    }
  }
}
